{
  "schema_version": 1,
  "protocol_id": "ConformEval-0.3-frozen-grouped-development",
  "source_accepted_protocol_sha256": "46cb535c76590af8fc29b13b1a9d5d4dbdd492ad9640470e11c0769d05ecdff5",
  "scope": "retrospective grouped-development evaluation; not prospective or family-independent testing",
  "prediction_table": {
    "columns": ["task_id", "sample_id", "outer_fold", "score"],
    "one_row_per_eligible_sample": true,
    "outer_fold_source": "data/v0.3.1/folds/outer_group_holdout.tsv",
    "labels_in_prediction_input": false
  },
  "reader_protocol": {
    "outer_test_predictions": "each score is generated by a reader fit without that sample's frozen outer-test group",
    "inner_selection": "frozen three-fold group validation within each outer-training partition",
    "preprocessing": "fit on the current training partition only",
    "c_grid": [0.1, 1.0],
    "solver": "liblinear",
    "class_weight": "balanced",
    "max_iter": 5000,
    "seed": 2026,
    "selection_ties": ["smaller_C", "shallower_layer"]
  },
  "tasks": {
    "KNOT-PRESENCE": {
      "outer_folds": 5,
      "inner_folds": 3,
      "primary_metric": "pooled_outer_fold_OOF_AUROC",
      "secondary_metric": "average_precision",
      "inner_selection_metric": "mean_inner_validation_AUROC",
      "bootstrap_unit": "binding_group_id"
    },
    "FS-L2-grouped-PU-ranking": {
      "outer_folds": 10,
      "inner_folds": 3,
      "primary_metric": "mean_held_positive_rank_percentile_within_own_outer_test_pool_lower_is_better",
      "secondary_metrics": ["Recall@1", "Recall@10", "Recall@100", "Recall@1000", "Recall@10000"],
      "inner_selection_metric": "mean_inner_held_positive_rank_percentile_within_own_validation_pool_lower_is_better",
      "bootstrap_unit": "positive_binding_group_id",
      "unlabeled_background_is_biological_negative": false
    }
  },
  "uncertainty": {
    "bootstrap_replicates": 2000,
    "seed": 2026,
    "confidence_level": 0.95,
    "scope": "conditional on fixed outer-fold predictions; no refitting uncertainty claim"
  },
  "new_model_inference": "not included; model-specific prediction generation is supplied by the model owner"
}
